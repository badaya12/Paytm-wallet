generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                 @id @default(autoincrement())
  email             String?             @unique
  name              String?
  number            String              @unique
  password          String
  OnRampTransaction OnRampTransaction[]
  Balance           Balance[]
  SentTransfer P2PTransaction[] @relation(name : "fromTransactions")
  ReceivedTransfer P2PTransaction[] @relation(name : "toTransactions")
  LedgerEntry LedgerEntry[]
}

model Merchant {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  auth_type AuthType
}

model OnRampTransaction {
  id        Int          @id @default(autoincrement())
  status    OnRampStatus
  token     String       @unique
  provider  String
  amount    Int
  startTime DateTime
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
}

model Balance {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  amount Int
  locked Int
  user   User @relation(fields: [userId], references: [id])
}

model P2PTransaction{
  id Int @id  @default(autoincrement())
  amount Int
  from User @relation(name :"fromTransactions",fields : [fromId], references : [id])
  to  User @relation(name : "toTransactions",fields : [toId], references : [id])
  fromId Int
  toId Int
  timeStamp DateTime
}

/// An atomic, balanced set of ledger entries. `idempotencyKey` is the natural
/// key of the business event that produced it, so replaying that event is a no-op.
model LedgerTransaction {
  id             String                @id @default(uuid())
  type           LedgerTransactionType
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())
  entries        LedgerEntry[]
}

/// One signed leg of a ledger transaction, in paise. A null `userId` is the
/// external account (the bank / PSP on the other side of an on-ramp).
model LedgerEntry {
  id            Int               @id @default(autoincrement())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  userId        Int?
  user          User?             @relation(fields: [userId], references: [id])
  amount        Int
  createdAt     DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([transactionId])
}

enum LedgerTransactionType {
  OnRamp
  P2pTransfer
  Adjustment
}

enum AuthType {
  Google
  Github
}

enum OnRampStatus {
  Success
  Failure
  Processing
}
