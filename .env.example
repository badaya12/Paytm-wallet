# Copy to packages/db/.env, apps/user-app/.env and apps/backend-webhook/.env.
# The default matches the Postgres service in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paytm"

# NextAuth signing secret (user-app).
JWT_SECRET="change-me"

# Shared secret the bank signs its callback body with (backend-webhook).
# The webhook refuses to credit any balance when this is unset.
HDFC_WEBHOOK_SECRET="change-me"
